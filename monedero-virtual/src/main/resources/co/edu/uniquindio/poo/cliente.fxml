<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.viewController.ClienteViewController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <Button onAction="#volver" text="← Volver" />
            <Label text="Clientes y monederos" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
         </children>
         <padding>
            <Insets bottom="10.0" />
         </padding>
      </HBox>
   </top>
   <left>
      <VBox spacing="10.0" prefWidth="300.0">
         <children>
            <Label text="Datos del cliente" style="-fx-font-weight: bold;" />
            <GridPane hgap="8.0" vgap="8.0">
               <children>
                  <Label text="Documento:" GridPane.rowIndex="0" />
                  <TextField fx:id="txtDocumento" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Nombre:" GridPane.rowIndex="1" />
                  <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Correo:" GridPane.rowIndex="2" />
                  <TextField fx:id="txtCorreo" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label text="Teléfono:" GridPane.rowIndex="3" />
                  <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               </children>
            </GridPane>
            <HBox spacing="8.0">
               <children>
                  <Button onAction="#agregarCliente" text="Agregar" />
                  <Button onAction="#actualizarCliente" text="Actualizar" />
                  <Button onAction="#eliminarCliente" text="Eliminar" />
                  <Button onAction="#limpiarCampos" text="Limpiar" />
               </children>
            </HBox>
            <Label fx:id="lblClienteSeleccionado" text="Monederos" style="-fx-font-weight: bold;">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </Label>
            <GridPane hgap="8.0" vgap="8.0">
               <children>
                  <Label text="Nombre:" GridPane.rowIndex="0" />
                  <TextField fx:id="txtNombreMonedero" promptText="Ej: Ahorros" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Tipo:" GridPane.rowIndex="1" />
                  <ComboBox fx:id="cmbTipoMonedero" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               </children>
            </GridPane>
            <Button onAction="#crearMonedero" text="Crear monedero" />
         </children>
         <BorderPane.margin>
            <Insets right="15.0" />
         </BorderPane.margin>
      </VBox>
   </left>
   <center>
      <VBox spacing="10.0">
         <children>
            <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colDocumento" prefWidth="100.0" text="Documento" />
                  <TableColumn fx:id="colNombre" prefWidth="130.0" text="Nombre" />
                  <TableColumn fx:id="colCorreo" prefWidth="160.0" text="Correo" />
                  <TableColumn fx:id="colTelefono" prefWidth="100.0" text="Teléfono" />
                  <TableColumn fx:id="colRango" prefWidth="70.0" text="Rango" />
                  <TableColumn fx:id="colPuntos" prefWidth="60.0" text="Puntos" />
                  <TableColumn fx:id="colSaldo" prefWidth="100.0" text="Saldo total" />
               </columns>
            </TableView>
            <TableView fx:id="tblMonederos" prefHeight="200.0">
               <columns>
                  <TableColumn fx:id="colCodigoMonedero" prefWidth="140.0" text="Código" />
                  <TableColumn fx:id="colNombreMonedero" prefWidth="180.0" text="Nombre" />
                  <TableColumn fx:id="colTipoMonedero" prefWidth="160.0" text="Tipo" />
                  <TableColumn fx:id="colSaldoMonedero" prefWidth="120.0" text="Saldo" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
